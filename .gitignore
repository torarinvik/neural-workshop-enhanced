# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
wheels/

# Compiled extensions (rebuilt with `python setup.py build_ext --inplace`)
*.so
*.pyd
*.dll

# Virtual environments
.venv/
venv/
env/

# Test, type-check and lint caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/

# Logs and scratch output
*.log
*.tmp

# Settings, statistics and saves written when run from the source tree;
# the shipped readme stays tracked.
data/*
!data/Readme-stats.txt

# Libraries once bundled by hand for Python 2 (pyglet, python-future)
pyglet/
future/
past/
libfuturize/

# Editors and operating systems
.idea/
.vscode/
*.swp
*~
.DS_Store
Thumbs.db

# Agent worktrees, session state and working plans
.claude/
*_PLAN.md
